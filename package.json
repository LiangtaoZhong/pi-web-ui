{
  "name": "pi-web-ui",
  "version": "2.0.0",
  "description": "React + Vite Web UI for Pi Coding Agent",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "echo '需要两个终端:\\n  终端1: npm run dev:server\\n  终端2: npm run dev:client\\n  然后访问 http://localhost:5173'",
    "dev:server": "node server.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "node test/e2e.js"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.21.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
